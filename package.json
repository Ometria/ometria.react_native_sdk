{
  "name": "react-native-ometria",
  "version": "2.7.0",
  "description": "We help retailers create marketing experiences their customers will love",
  "main": "src/index.tsx",
  "module": "src/index.tsx",
  "types": "src/index.tsx",
  "react-native": "src/index",
  "source": "src/index",
  "app.plugin": "./app.plugin.js",
  "ometria_sdk_version": {
    "ios": "1.8.4",
    "android": "1.11.0"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "scripts",
    "plugin/build",
    "app.plugin.js",
    "ometria-react-native-sdk.podspec",
    "!lib/typescript/example",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__"
  ],
  "scripts": {
    "test": "jest",
    "typescript": "tsc --noEmit",
    "lint": "eslint --fix \"**/*.{js,ts,tsx}\"",
    "release": "release-it",
    "example": "yarn --cwd example",
    "pods": "cd example && pod-install --quiet",
    "bootstrap": "yarn example && yarn && yarn pods",
    "build:plugin": "cd plugin && npm run build",
    "clean:plugin": "cd plugin && npm run clean",
    "prepare": "npm run build:plugin"
  },
  "keywords": [
    "react-native",
    "expo",
    "expo-plugin",
    "ios",
    "android",
    "push-notifications",
    "analytics"
  ],
  "repository": "https://github.com/Ometria/ometria.react-native_sdk",
  "author": "Ometria <support@ometria.com> (https://github.com/Ometria)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Ometria/ometria.react-native_sdk/issues"
  },
  "homepage": "https://github.com/Ometria/ometria.react-native_sdk#readme",
  "devDependencies": {
    "@commitlint/config-conventional": "^18.4.3",
    "@expo/config-plugins": "^9.0.0",
    "@react-native-firebase/messaging": "^23.7.0",
    "@types/jest": "^29.5.11",
    "@types/react": "^19.1.2",
    "@types/react-native": "0.73.0",
    "commitlint": "^18.4.3",
    "eslint": "^8.19.0",
    "husky": "^4.2.5",
    "jest": "^26.0.1",
    "pod-install": "^0.1.39",
    "prettier": "^2.4.1",
    "react": "19.1.0",
    "release-it": "^17.0.1",
    "typescript": "5.0.4",
    "@react-native-community/eslint-config": "^3.2.0",
    "react-native": "0.81.5"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "expo": ">=53.0.0"
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": true
    }
  },
  "jest": {
    "preset": "react-native",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "angular"
      }
    }
  },
  "eslintConfig": {
    "extends": [
      "@react-native-community",
      "prettier"
    ],
    "rules": {
      "prettier/prettier": [
        "error",
        {
          "quoteProps": "consistent",
          "singleQuote": true,
          "tabWidth": 2,
          "trailingComma": "es5",
          "useTabs": false
        }
      ]
    }
  },
  "eslintIgnore": [
    "node_modules/",
    "lib/"
  ],
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "codegenConfig": {
    "name": "OmetriaReactNativeSdkSpec",
    "type": "modules",
    "jsSrcsDir": "./src",
    "android": {
      "javaPackageName": "com.ometriareactnativesdk"
    }
  }
}
