{
  "name": "react-native-ometria",
  "version": "2.8.0",
  "description": "We help retailers create marketing experiences their customers will love",
  "main": "src/index.tsx",
  "module": "src/index.tsx",
  "types": "src/index.tsx",
  "react-native": "src/index",
  "source": "src/index",
  "app.plugin": "./app.plugin.js",
  "ometria_sdk_version": {
    "ios": "1.8.9",
    "android": "1.11.2"
  },
  "files": [
    "src",
    "android",
    "ios",
    "scripts",
    "plugin/build",
    "app.plugin.js",
    "ometria-react-native-sdk.podspec",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!android/build",
    "!android/.gradle",
    "!ios/Pods",
    "!ios/build"
  ],
  "scripts": {
    "typescript": "tsc --noEmit",
    "lint": "eslint --fix \"**/*.{js,ts,tsx}\"",
    "example": "pnpm --filter example",
    "pods": "cd example && pod-install --quiet",
    "build:plugin": "cd plugin && pnpm run build",
    "prepare": "husky && pnpm run build:plugin"
  },
  "keywords": [
    "react-native",
    "expo",
    "expo-plugin",
    "ios",
    "android",
    "push-notifications",
    "analytics"
  ],
  "repository": "https://github.com/Ometria/ometria.react_native_sdk",
  "author": "Ometria <support@ometria.com> (https://github.com/Ometria)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Ometria/ometria.react_native_sdk/issues"
  },
  "homepage": "https://github.com/Ometria/ometria.react_native_sdk#readme",
  "devDependencies": {
    "@expo/config-plugins": "^9.0.0",
    "@react-native-community/eslint-config": "^3.2.0",
    "@react-native-firebase/messaging": "^23.7.0",
    "@types/react": "^19.1.2",
    "@types/react-native": "0.73.0",
    "eslint": "^8.19.0",
    "husky": "^9.1.7",
    "pod-install": "^0.1.39",
    "prettier": "^2.4.1",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "5.0.4"
  },
  "peerDependencies": {
    "expo": ">=53.0.0",
    "react": "*",
    "react-native": "*"
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": true
    }
  },
  "eslintConfig": {
    "extends": [
      "@react-native-community",
      "prettier"
    ],
    "rules": {
      "prettier/prettier": [
        "error",
        {
          "quoteProps": "consistent",
          "singleQuote": true,
          "tabWidth": 2,
          "trailingComma": "es5",
          "useTabs": false
        }
      ]
    }
  },
  "eslintIgnore": [
    "node_modules/",
    "lib/"
  ],
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "codegenConfig": {
    "name": "OmetriaReactNativeSdkSpec",
    "type": "modules",
    "jsSrcsDir": "./src",
    "android": {
      "javaPackageName": "com.ometriareactnativesdk"
    }
  },
  "pnpm": {
    "overrides": {
      "minimatch@3": "3.1.5",
      "minimatch@9": "9.0.9",
      "brace-expansion@1": "1.1.13",
      "brace-expansion@2": "2.0.3",
      "shell-quote@1": "1.8.4"
    }
  }
}
